import Houghton.Upper
import Houghton.Images
import Houghton.Cremona
import Houghton.Area.Main
import Houghton.Area.WeightedReal
import Houghton.Analysis.DimensionPerm

/-!
# Theorem 1.1 and Corollary 1.2, assembled

The area bounds (`astar_le_pow`, `astar_le_weighted_rpow`) are proved unconditionally in
`Houghton.Area`; Proposition `prop:dimension-perm` is proved in `Houghton.Analysis` from the sector
bound `PermSectorBound` (Theorem `thm:phase-robust`, permutation form). Hence the lower bounds
below depend only on `PermSectorBound`; the upper bound is unconditional.
-/

namespace Houghton

theorem areaStatement : AreaStatement := astar_le_pow

theorem astarLE_mono {M n n' : ℕ} (h : AstarLE M n) (hn : n ≤ n') : AstarLE M n' := by
  intro p q hp hq hpq e₁ e₂
  obtain ⟨cs, hl, he⟩ := h p q hp hq hpq e₁ e₂
  exact ⟨cs, hl.trans hn, he⟩

theorem weightedAreaStatement : WeightedAreaStatement := by
  intro M hM
  obtain ⟨n, hA, hn⟩ := astar_le_weighted_rpow M (by omega)
  exact astarLE_mono hA (Nat.le_floor hn)

theorem dimensionPermStatement (hS : PermSectorBound.{0}) : DimensionPermStatement :=
  fun φ δ h1 h2 N A h3 h4 h5 => dimension_perm_of_sectorBound hS φ δ h1 h2 N A h3 h4 h5

/-- Superseded by `Houghton.theorem_1_1_SSA` (`Houghton/Headline.lean`), which derives the sector
bound from strong subadditivity (`permSectorBound_of_SSA`).

**Theorem 1.1** (given the sector bound): for `r ≥ 2`,
`2^{r^{1/(log₂107+1)}/1280 - 1/16} ≤ σ_{E_H}(r) ≤ 2^{7000 √r log₂ r}`, and the unweighted bound
`2^{r^{1/12}/270 - 1/16} ≤ σ_{E_H}(r)`. -/
theorem theorem_1_1 (hS : PermSectorBound.{0}) (r : ℝ) (hr : 2 ≤ r) :
    (∀ m : ℕ, profile E_H r = m →
      (2:ℝ) ^ (r ^ (1 / (Real.logb 2 107 + 1)) / 1280 - 1 / 16) ≤ m ∧
      (2:ℝ) ^ (r ^ ((1:ℝ) / 12) / 270 - 1 / 16) ≤ m) ∧
    ∃ n : ℕ, profile E_H r ≤ n ∧ (n : ℝ) ≤ 2 ^ (7000 * √r * Real.logb 2 r) :=
  ⟨fun m hm => ⟨profile_lower_weighted (dimensionPermStatement hS) weightedAreaStatement hr m hm,
    profile_lower_unweighted (dimensionPermStatement hS) areaStatement hr m hm⟩,
   profile_upper r hr⟩

/-- **Corollary 1.2** (given the sector bound): the profile of `E_H` is not bounded by any
polynomial. -/
theorem corollary_1_2 (hS : PermSectorBound.{0}) :
    ∀ k C : ℝ, ∃ r : ℝ, 2 ≤ r ∧ ∀ m : ℕ, profile E_H r = m → C * r ^ k < m :=
  not_polynomially_bounded (dimensionPermStatement hS) areaStatement

/-- Corollary `cor:cremona`, first step (given the sector bound). -/
theorem cremona_kills_γ (hS : PermSectorBound.{0}) {Γ : Type*} [Group Γ] (h : H3 →* Γ)
    (hpoly : ∀ E : Finset Γ, (1 : Γ) ∈ E → ∃ k C R : ℝ, ∀ r : ℝ, R ≤ r →
      ∃ m : ℕ, profile E r = m ∧ (m : ℝ) ≤ C * r ^ k) :
    h (ρH' γ) = 1 :=
  kills_γ (dimensionPermStatement hS) areaStatement h hpoly

/-- Corollary `cor:cremona` for `H₃` (given the sector bound): the subgroup generated by the
finitary 3-cycles is killed. -/
theorem cremona_finAlt3 (hS : PermSectorBound.{0}) {Γ : Type*} [Group Γ] (h : H3 →* Γ)
    (hpoly : ∀ E : Finset Γ, (1 : Γ) ∈ E → ∃ k C R : ℝ, ∀ r : ℝ, R ≤ r →
      ∃ m : ℕ, profile E r = m ∧ (m : ℝ) ≤ C * r ^ k) :
    finAlt3 ≤ h.ker :=
  kills_finAlt3 (dimensionPermStatement hS) areaStatement h hpoly

end Houghton
