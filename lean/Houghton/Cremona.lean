import Houghton.Images
import Mathlib.GroupTheory.Perm.ClosureSwap
import Mathlib.Algebra.Group.Subgroup.MulOpposite

/-!
# Corollary `cor:cremona` for `H₃`: killing the finitary 3-cycles

`H₃` contains every finitary permutation of `Y` (`finitary_mem`); every finitary 3-cycle
`p ↦ q ↦ s ↦ p` (as a permutation of `Y`: `swap p s * swap p q`) is conjugate in `H₃` to `γ`; so a
homomorphism `H₃ → Γ` that kills `γ` kills every finitary 3-cycle (`kills_threeCycles_of`). With
`kills_γ`, a homomorphism from `H₃` to a group whose chunks all have polynomially bounded profile
kills the subgroup generated by the finitary 3-cycles (`kills_threeCycles`), i.e. the finitary
alternating group.
-/

namespace Houghton

open Equiv

/-- `H₃` viewed in `Perm Y` (Mathlib's product: the paper's product reversed). -/
abbrev K3 : Subgroup (Perm Y) := H3.unop

theorem mem_K3_of (w : F) {g : Perm Y} (h : (ρH w).unop = g) : g ∈ K3 := by
  rw [Subgroup.mem_unop, ← h, MulOpposite.op_unop]; exact ⟨w, rfl⟩

theorem conj_alpha_unop (w : F) :
    (ρH (w * α * w⁻¹)).unop = swap (((ρH w).unop)⁻¹ (0, 0)) (((ρH w).unop)⁻¹ (0, 1)) := by
  have hα : ρH α = MulOpposite.op alPerm := rho_of 2
  rw [map_mul, map_mul, map_inv, hα, MulOpposite.unop_mul, MulOpposite.unop_mul,
    MulOpposite.unop_inv, MulOpposite.unop_op, alPerm_eq_swap, swap_apply_apply, inv_inv,
    mul_assoc]

theorem aPerm_pow_ray1 (n m : ℕ) : (aPerm ^ n) ((1 : Fin 3), m) = (1, m + n) := by
  induction n generalizing m with
  | zero => rfl
  | succ n ih => rw [pow_succ, Perm.mul_apply, show aPerm ((1 : Fin 3), m) = (1, m + 1) from rfl, ih]; congr 1; omega

theorem bPerm_pow_ray2 (n m : ℕ) : (bPerm ^ n) ((2 : Fin 3), m) = (2, m + n) := by
  induction n generalizing m with
  | zero => rfl
  | succ n ih => rw [pow_succ, Perm.mul_apply, show bPerm ((2 : Fin 3), m) = (2, m + 1) from rfl, ih]; congr 1; omega

theorem rhoA_inv_pow (k : ℕ) : ((ρH (a⁻¹ ^ k)).unop)⁻¹ = aPerm ^ k := by
  rw [map_pow, map_inv, show ρH a = MulOpposite.op aPerm from rho_of 0, MulOpposite.unop_pow,
    MulOpposite.unop_inv, MulOpposite.unop_op, inv_pow, inv_inv]

theorem rhoB_inv_pow (k : ℕ) : ((ρH (b⁻¹ ^ k)).unop)⁻¹ = bPerm ^ k := by
  rw [map_pow, map_inv, show ρH b = MulOpposite.op bPerm from rho_of 1, MulOpposite.unop_pow,
    MulOpposite.unop_inv, MulOpposite.unop_op, inv_pow, inv_inv]

theorem swap_ray0 (n : ℕ) : swap ((0 : Fin 3), n) ((0 : Fin 3), n + 1) ∈ K3 :=
  mem_K3_of (σ n) (rho_σ_unop n)

theorem swap_ray1 (n : ℕ) : swap ((1 : Fin 3), n + 1) ((1 : Fin 3), n) ∈ K3 := by
  apply mem_K3_of (a⁻¹ ^ (n + 2) * α * (a⁻¹ ^ (n + 2))⁻¹)
  rw [conj_alpha_unop, rhoA_inv_pow]
  have h1 : (aPerm ^ (n + 2)) ((0 : Fin 3), 0) = (1, n + 1) := by
    rw [pow_succ, Perm.mul_apply, show aPerm ((0 : Fin 3), 0) = (1, 0) from rfl, aPerm_pow_ray1]
    simp
  have h2 : (aPerm ^ (n + 2)) ((0 : Fin 3), 1) = (1, n) := by
    rw [pow_succ, pow_succ, Perm.mul_apply, Perm.mul_apply,
      show aPerm ((0 : Fin 3), 1) = (0, 0) from rfl, show aPerm ((0 : Fin 3), 0) = (1, 0) from rfl,
      aPerm_pow_ray1]
    simp
  rw [h1, h2]

theorem swap_junction1 : swap ((1 : Fin 3), 0) ((0 : Fin 3), 0) ∈ K3 := by
  apply mem_K3_of (a⁻¹ ^ 1 * α * (a⁻¹ ^ 1)⁻¹)
  rw [conj_alpha_unop, rhoA_inv_pow]; rfl

theorem swap_ray2 (n : ℕ) : swap ((2 : Fin 3), n + 1) ((2 : Fin 3), n) ∈ K3 := by
  apply mem_K3_of (b⁻¹ ^ (n + 2) * α * (b⁻¹ ^ (n + 2))⁻¹)
  rw [conj_alpha_unop, rhoB_inv_pow]
  have h1 : (bPerm ^ (n + 2)) ((0 : Fin 3), 0) = (2, n + 1) := by
    rw [pow_succ, Perm.mul_apply, show bPerm ((0 : Fin 3), 0) = (2, 0) from rfl, bPerm_pow_ray2]
    simp
  have h2 : (bPerm ^ (n + 2)) ((0 : Fin 3), 1) = (2, n) := by
    rw [pow_succ, pow_succ, Perm.mul_apply, Perm.mul_apply,
      show bPerm ((0 : Fin 3), 1) = (0, 0) from rfl, show bPerm ((0 : Fin 3), 0) = (2, 0) from rfl,
      bPerm_pow_ray2]
    simp
  rw [h1, h2]

theorem swap_junction2 : swap ((2 : Fin 3), 0) ((0 : Fin 3), 0) ∈ K3 := by
  apply mem_K3_of (b⁻¹ ^ 1 * α * (b⁻¹ ^ 1)⁻¹)
  rw [conj_alpha_unop, rhoB_inv_pow]; rfl

/-- Moving along an edge. -/
theorem swap_step {x y z : Y} (hxy : x ≠ y) (hxz : x ≠ z) (h1 : swap x y ∈ K3) (h2 : swap y z ∈ K3) :
    swap x z ∈ K3 := by
  have := K3.mul_mem (K3.mul_mem h2 h1) h2
  rwa [swap_mul_swap_mul_swap hxy hxz, swap_comm] at this

theorem swap_origin (y : Y) : swap ((0 : Fin 3), 0) y ∈ K3 := by
  obtain ⟨⟨_ | _ | _ | r, hr⟩, n⟩ := y
  · induction n with
    | zero => rw [show ((⟨0, hr⟩ : Fin 3), (0 : ℕ)) = ((0 : Fin 3), 0) from rfl, swap_self]
              exact K3.one_mem
    | succ n ih =>
      rcases n with _ | n
      · exact swap_ray0 0
      · exact swap_step (by simp) (by simp) ih (swap_ray0 (n + 1))
  · induction n with
    | zero => rw [swap_comm]; exact swap_junction1
    | succ n ih =>
      have := swap_ray1 n; rw [swap_comm] at this
      exact swap_step (by simp) (by simp) ih this
  · induction n with
    | zero => rw [swap_comm]; exact swap_junction2
    | succ n ih =>
      have := swap_ray2 n; rw [swap_comm] at this
      exact swap_step (by simp) (by simp) ih this
  · omega

theorem swap_mem (y z : Y) : swap y z ∈ K3 := by
  by_cases hyz : y = z
  · rw [hyz, swap_self]; exact K3.one_mem
  by_cases hy : y = ((0 : Fin 3), 0)
  · rw [hy]; exact swap_origin z
  by_cases hz : z = ((0 : Fin 3), 0)
  · rw [hz, swap_comm]; exact swap_origin y
  have h1 := swap_origin y
  rw [swap_comm] at h1
  exact swap_step hy hyz h1 (swap_origin z)

/-- **`FSym(Y) ⊆ H₃`**: every finitary permutation of `Y` lies in `H₃`. -/
theorem finitary_mem {g : Perm Y} (hg : (MulAction.fixedBy Y g)ᶜ.Finite) :
    MulOpposite.op g ∈ H3 := by
  rw [← Subgroup.mem_unop]
  have hle : Subgroup.closure {σ : Perm Y | σ.IsSwap} ≤ K3 := by
    rw [Subgroup.closure_le]
    rintro σ ⟨x, y, -, rfl⟩
    exact swap_mem x y
  exact hle (mem_closure_isSwap'.mpr hg)

/-- `γ` acts as the 3-cycle `(1,1) ↦ (1,3) ↦ (1,2) ↦ (1,1)`. -/
theorem rho_γ_unop :
    (ρH γ).unop = swap ((0 : Fin 3), 0) ((0 : Fin 3), 1) * swap ((0 : Fin 3), 0) ((0 : Fin 3), 2) := by
  ext ⟨⟨_ | _ | _ | r, hr⟩, _ | _ | _ | n⟩ : 1
  all_goals first
    | omega
    | (rw [← wordF_γWord, rho_word_apply]; simp [swap_apply_def]; rfl)


theorem exists_perm3 {x₁ x₂ x₃ y₁ y₂ y₃ : Y} (hx12 : x₁ ≠ x₂) (hx13 : x₁ ≠ x₃) (hx23 : x₂ ≠ x₃)
    (hy12 : y₁ ≠ y₂) (hy13 : y₁ ≠ y₃) (hy23 : y₂ ≠ y₃) :
    ∃ k ∈ K3, k x₁ = y₁ ∧ k x₂ = y₂ ∧ k x₃ = y₃ := by
  set k1 := swap x₁ y₁
  set k2 := swap (k1 x₂) y₂
  set k3 := swap (k2 (k1 x₃)) y₃
  have e1 : k1 x₁ = y₁ := swap_apply_left _ _
  have n1 : k1 x₂ ≠ y₁ := fun h => hx12 (k1.injective (h.trans e1.symm)).symm
  have n2 : k1 x₃ ≠ y₁ := fun h => hx13 (k1.injective (h.trans e1.symm)).symm
  have e2 : k2 y₁ = y₁ := swap_apply_of_ne_of_ne (Ne.symm n1) hy12
  have e3 : k2 (k1 x₂) = y₂ := swap_apply_left _ _
  have m1 : k2 (k1 x₃) ≠ y₁ := fun h => n2 (k2.injective (h.trans e2.symm))
  have m2 : k2 (k1 x₃) ≠ y₂ := fun h => hx23 (k1.injective (k2.injective (h.trans e3.symm))).symm
  refine ⟨k3 * k2 * k1, K3.mul_mem (K3.mul_mem (swap_mem _ _) (swap_mem _ _)) (swap_mem _ _),
    ?_, ?_, ?_⟩
  · simp only [Perm.mul_apply, e1, e2]; exact swap_apply_of_ne_of_ne (Ne.symm m1) hy13
  · simp only [Perm.mul_apply, e3]; exact swap_apply_of_ne_of_ne (Ne.symm m2) hy23
  · simp only [Perm.mul_apply]; exact swap_apply_left _ _

/-- The finitary 3-cycle `p ↦ q ↦ s ↦ p`. -/
def cyc3 (p q s : Y) : Perm Y := swap p s * swap p q

theorem cyc3_finite (p q s : Y) : (MulAction.fixedBy Y (cyc3 p q s))ᶜ.Finite := by
  apply Set.Finite.subset (Set.toFinite ({p, q, s} : Set Y))
  intro y hy
  simp only [Set.mem_compl_iff, MulAction.mem_fixedBy, Perm.smul_def, cyc3, Perm.mul_apply] at hy
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  by_contra hc; push Not at hc
  apply hy
  rw [swap_apply_of_ne_of_ne hc.1 hc.2.1, swap_apply_of_ne_of_ne hc.1 hc.2.2]

/-- The finitary 3-cycles as elements of `H₃`. -/
def cyc3H (p q s : Y) : H3 := ⟨MulOpposite.op (cyc3 p q s), finitary_mem (cyc3_finite p q s)⟩

/-- Every finitary 3-cycle is conjugate in `H₃` to `γ`. -/
theorem cyc3_conj (p q s : Y) (hpq : p ≠ q) (hps : p ≠ s) (hqs : q ≠ s) :
    ∃ g : H3, cyc3H p q s = g * ρH' γ * g⁻¹ := by
  obtain ⟨k, hk, h1, h2, h3⟩ := exists_perm3 (x₁ := ((0 : Fin 3), 0)) (x₂ := ((0 : Fin 3), 1))
    (x₃ := ((0 : Fin 3), 2)) (by simp) (by simp) (by simp) hps hpq (Ne.symm hqs)
  refine ⟨⟨(MulOpposite.op k)⁻¹, H3.inv_mem hk⟩, ?_⟩
  apply Subtype.ext
  apply MulOpposite.unop_injective
  simp only [cyc3H, Subgroup.coe_mul, Subgroup.coe_inv, inv_inv, MulOpposite.unop_mul,
    MulOpposite.unop_inv, MulOpposite.unop_op, ρH', MonoidHom.coe_rangeRestrict, rho_γ_unop]
  have e1 : k * swap ((0 : Fin 3), 0) ((0 : Fin 3), 1) * k⁻¹ = swap p s := by
    rw [← swap_apply_apply, h1, h2]
  have e2 : k * swap ((0 : Fin 3), 0) ((0 : Fin 3), 2) * k⁻¹ = swap p q := by
    rw [← swap_apply_apply, h1, h3]
  rw [cyc3, ← e1, ← e2]
  group

/-- A homomorphism killing `γ` kills every finitary 3-cycle. -/
theorem kills_threeCycles_of {Γ : Type*} [Group Γ] (h : H3 →* Γ) (hγ : h (ρH' γ) = 1)
    (p q s : Y) (hpq : p ≠ q) (hps : p ≠ s) (hqs : q ≠ s) : h (cyc3H p q s) = 1 := by
  obtain ⟨g, hg⟩ := cyc3_conj p q s hpq hps hqs
  rw [hg, map_mul, map_mul, hγ, mul_one, map_inv, mul_inv_cancel]

/-- The subgroup of `H₃` generated by the finitary 3-cycles (the finitary alternating group). -/
def finAlt3 : Subgroup H3 :=
  Subgroup.closure {x | ∃ p q s : Y, p ≠ q ∧ p ≠ s ∧ q ≠ s ∧ x = cyc3H p q s}

/-- **Corollary `cor:cremona` for `H₃`, first sentence**: if every chunk of `Γ` has profile
bounded by a polynomial for large `r`, then every homomorphism `H₃ → Γ` kills the finitary
3-cycles, hence the subgroup they generate. (Hypotheses `hdim`, `harea` as in `Main.lean`.) -/
theorem kills_finAlt3 (hdim : DimensionPermStatement) (harea : AreaStatement) {Γ : Type*}
    [Group Γ] (h : H3 →* Γ)
    (hpoly : ∀ E : Finset Γ, (1 : Γ) ∈ E → ∃ k C R : ℝ, ∀ r : ℝ, R ≤ r →
      ∃ m : ℕ, profile E r = m ∧ (m : ℝ) ≤ C * r ^ k) :
    finAlt3 ≤ h.ker := by
  have hγ := kills_γ hdim harea h hpoly
  rw [finAlt3, Subgroup.closure_le]
  rintro x ⟨p, q, s, hpq, hps, hqs, rfl⟩
  exact kills_threeCycles_of h hγ p q s hpq hps hqs

end Houghton
